{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository",
    "runner",
    "argv",
    "manifest_sha256",
    "profile_sha256",
    "report_format",
    "bindings"
  ],
  "properties": {
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "runner": {
      "type": "string",
      "minLength": 1
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "report_format": {
      "enum": [
        "junit",
        "playwright-json"
      ]
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "target_id",
          "asset",
          "asset_sha256",
          "test_id",
          "route",
          "assertion_ids"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "asset": {
            "type": "string",
            "minLength": 1
          },
          "test_id": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "type": "string",
            "minLength": 1
          },
          "authorization_ref": {
            "type": "string",
            "minLength": 1
          },
          "asset_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "assertion_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        }
      },
      "minItems": 1
    }
  }
}
