{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace",
    "runner",
    "argv",
    "manifest_sha256",
    "profile_sha256",
    "report_format",
    "bindings",
    "schema_version",
    "support_files"
  ],
  "properties": {
    "runner": {
      "type": "string",
      "minLength": 1
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "report_format": {
      "enum": [
        "junit",
        "playwright-json"
      ]
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "target_id",
          "asset",
          "asset_sha256",
          "test_id",
          "route",
          "assertion_ids",
          "review"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "asset": {
            "type": "string",
            "minLength": 1
          },
          "test_id": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "type": "string",
            "minLength": 1
          },
          "authorization_ref": {
            "type": "string",
            "minLength": 1
          },
          "asset_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "assertion_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "review": {
            "type": "string",
            "minLength": 1
          },
          "rerun": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "previous_receipt_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "kind": {
                "enum": [
                  "repeat",
                  "retry",
                  "test-repair"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "reset_note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "previous_receipt_sha256",
              "kind",
              "reason",
              "reset_note"
            ]
          }
        }
      },
      "minItems": 1
    },
    "schema_version": {
      "const": "2"
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "support_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      }
    }
  }
}
