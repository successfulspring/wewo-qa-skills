{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wewo QA Execution Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_path",
    "manifest_sha256",
    "suite",
    "targets",
    "collected_at",
    "bindings",
    "case_workbook_sha256"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.1",
        "1.2"
      ]
    },
    "manifest_path": {
      "type": "string",
      "minLength": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "suite": {
      "enum": [
        "smoke",
        "regression",
        "full"
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "notes": {
      "type": "string"
    },
    "case_workbook_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "discovered_requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/runtime_requirement"
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "test",
              "staging",
              "preview"
            ]
          },
          "entry": {
            "type": "string"
          },
          "build": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "target_id",
          "name",
          "kind",
          "entry",
          "build",
          "verified",
          "evidence"
        ]
      }
    },
    "case_readiness": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pending",
              "ready",
              "blocked",
              "manual"
            ]
          },
          "route": {
            "type": "string",
            "minLength": 1
          },
          "runtime_requirement_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^RT-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
            }
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "area": {
                  "enum": [
                    "interaction",
                    "observation",
                    "data",
                    "cleanup",
                    "tooling"
                  ]
                },
                "status": {
                  "enum": [
                    "pending",
                    "verified",
                    "not-applicable",
                    "blocked"
                  ]
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "area",
                "status",
                "detail"
              ]
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "case_id",
          "target_id",
          "status",
          "route",
          "runtime_requirement_refs",
          "checks",
          "reason"
        ]
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "status"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "pattern": "^RT-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "status": {
          "enum": [
            "resolved",
            "missing",
            "unavailable"
          ]
        },
        "source": {
          "enum": [
            "user-input",
            "environment-discovery",
            "secret-reference",
            "authenticated-session",
            "capability-check"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "secret_ref": {
          "type": "string",
          "minLength": 1
        },
        "session_ref": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtime_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "scope",
        "description",
        "sensitive",
        "collection"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^RT-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "environment",
            "build",
            "account",
            "credential",
            "test-data",
            "device",
            "capability",
            "permission",
            "other"
          ]
        },
        "scope": {
          "enum": [
            "run",
            "target",
            "case"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "target_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sensitive": {
          "type": "boolean"
        },
        "collection": {
          "enum": [
            "user-input",
            "environment-discovery",
            "secret-reference",
            "authenticated-session",
            "capability-check"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "target"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "required": [
              "target_ids"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.2"
          }
        }
      },
      "then": {
        "required": [
          "environments",
          "discovered_requirements",
          "case_readiness"
        ]
      }
    }
  ]
}
