{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wewo QA Execution Results",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "results"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "manifest_path", "manifest_sha256", "execution_profile_path", "execution_profile_sha256", "suite", "targets", "environment", "started_at", "finished_at"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "execution_profile_path": {"const": "execution-profile.json"},
        "execution_profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "suite": {"enum": ["smoke", "regression", "full"]},
        "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "kind", "build"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "kind": {"enum": ["test", "staging", "preview", "production", "other"]},
            "build": {"type": "string", "minLength": 1},
            "base_url": {"type": "string", "minLength": 1},
            "notes": {"type": "string"}
          }
        },
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "notes": {"type": "string"}
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/result"}
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "expected", "actual", "passed"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "expected": {"type": "string", "minLength": 1},
        "actual": {"type": "string", "minLength": 1},
        "passed": {"type": "boolean"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "description"],
      "properties": {
        "type": {"enum": ["screenshot", "accessibility-snapshot", "video", "console", "network", "log", "system-state", "other"]},
        "path": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "target_id", "status", "attempts", "tool", "assertions", "evidence", "observed"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "failed", "blocked", "flaky", "not-run"]},
        "attempts": {"type": "integer", "minimum": 0},
        "tool": {"type": "string"},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "assertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "observed": {"type": "string"},
        "failure_reason": {"type": "string", "minLength": 1},
        "blocker": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      }
    }
  }
}
