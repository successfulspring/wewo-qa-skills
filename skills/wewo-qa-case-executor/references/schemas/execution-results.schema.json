{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wewo QA Execution Results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": "1.3"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "manifest_path",
        "manifest_sha256",
        "execution_profile_path",
        "execution_profile_sha256",
        "suite",
        "targets",
        "environment",
        "started_at",
        "finished_at",
        "case_workbook_sha256"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "manifest_path": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "execution_profile_path": {
          "const": "execution-profile.json"
        },
        "execution_profile_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "suite": {
          "enum": [
            "smoke",
            "regression",
            "full"
          ]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "kind",
            "build"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "test",
                "staging",
                "preview",
                "production",
                "other"
              ]
            },
            "build": {
              "type": "string",
              "minLength": 1
            },
            "base_url": {
              "type": "string",
              "minLength": 1
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        },
        "case_workbook_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/result"
      }
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_id",
        "description",
        "expected",
        "actual",
        "status",
        "evidence_refs",
        "observations"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "actual": {
          "type": "string"
        },
        "assertion_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not-evaluated"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "phase": {
                "enum": [
                  "before",
                  "after"
                ]
              },
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "pointer": {
                "type": "string",
                "pattern": "^/raw(?:/.*)?$"
              }
            },
            "required": [
              "attempt",
              "phase",
              "evidence_id",
              "pointer"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "judgments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attempt",
              "status",
              "reason"
            ],
            "properties": {
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "status": {
                "enum": [
                  "passed",
                  "failed"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path",
        "description",
        "id",
        "sha256"
      ],
      "properties": {
        "type": {
          "enum": [
            "screenshot",
            "accessibility-snapshot",
            "video",
            "console",
            "network",
            "log",
            "system-state",
            "other",
            "tool-output"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "target_id",
        "status",
        "attempts",
        "tool",
        "assertions",
        "evidence",
        "observed"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked",
            "flaky",
            "not-run"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "tool": {
          "type": "string"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "observed": {
          "type": "string"
        },
        "failure_reason": {
          "type": "string",
          "minLength": 1
        },
        "blocker": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        },
        "native_test": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "receipt_path",
            "receipt_sha256",
            "asset",
            "test_id",
            "route"
          ],
          "properties": {
            "receipt_path": {
              "type": "string",
              "minLength": 1
            },
            "asset": {
              "type": "string",
              "minLength": 1
            },
            "test_id": {
              "type": "string",
              "minLength": 1
            },
            "route": {
              "type": "string",
              "minLength": 1
            },
            "receipt_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  }
}
