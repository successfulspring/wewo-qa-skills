{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "run_id",
    "case_id",
    "target_id",
    "attempt",
    "subject",
    "location",
    "captured_at",
    "tool",
    "raw"
  ],
  "properties": {
    "format": {
      "enum": [
        "wewo-qa-ui-observation/1",
        "wewo-qa-native-observation/1"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "raw": {},
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_path",
        "receipt_sha256",
        "line",
        "phase"
      ],
      "properties": {
        "receipt_path": {
          "type": "string",
          "minLength": 1
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "enum": [
            "before",
            "after"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "format": {
            "const": "wewo-qa-native-observation/1"
          }
        }
      },
      "then": {
        "required": [
          "native"
        ]
      },
      "else": {
        "not": {
          "required": [
            "native"
          ]
        }
      }
    }
  ]
}
