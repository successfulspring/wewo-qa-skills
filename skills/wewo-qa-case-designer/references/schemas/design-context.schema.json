{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.2"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "artifact_id"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "flows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flow"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "material": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "description",
          "material"
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "draft",
            "confirmed"
          ]
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        },
        "checks": {
          "type": "array",
          "items": {
            "enum": [
              "source-fidelity",
              "coverage",
              "executability",
              "oracle-consistency"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "enum": [
                  "source-fidelity",
                  "coverage",
                  "executability",
                  "oracle-consistency"
                ]
              },
              "scope_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "open",
                  "resolved"
                ]
              },
              "resolution": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "category",
              "scope_refs",
              "description",
              "status"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "status"
      ]
    },
    "requirement_confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "confirmed"
          ]
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time"
        },
        "response_ref": {
          "type": "string",
          "minLength": 1
        },
        "response_text": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "project",
    "sources",
    "segments",
    "decisions",
    "objects",
    "relationships",
    "flows",
    "rules",
    "open_questions",
    "review",
    "requirement_confirmation"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wewo QA Design Context",
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "type",
        "locator",
        "authority",
        "scope",
        "inventory_status",
        "method"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SRC-[0-9]{3,}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "dingtalk-doc",
            "document",
            "spreadsheet",
            "presentation",
            "pdf",
            "image",
            "audio",
            "video",
            "xmind",
            "url",
            "text",
            "other"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "authority": {
          "enum": [
            "authoritative",
            "supporting",
            "historical",
            "unknown"
          ]
        },
        "notes": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "included",
            "excluded"
          ]
        },
        "inventory_status": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "unit_id",
        "question_id",
        "topic",
        "resolution",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DEC-[0-9]{3,}$"
        },
        "unit_id": {
          "type": "string",
          "pattern": "^RU-[0-9]{3,}$"
        },
        "question_id": {
          "type": "string",
          "pattern": "^Q-RU[0-9]{3,}-[0-9]{2,}$"
        },
        "selected_options": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-D]$"
          }
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "resolution": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "confirmed",
            "assumed"
          ]
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "positive",
            "negative",
            "boundary",
            "state",
            "role",
            "cross-object"
          ]
        },
        "applicability": {
          "enum": [
            "required",
            "not-applicable"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "test_point_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "dimension",
        "applicability",
        "test_point_refs"
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^RULE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "input",
            "decision",
            "transition",
            "permission",
            "calculation",
            "interaction",
            "invariant",
            "other"
          ]
        },
        "object_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "segment_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "decision_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "confirmed",
            "assumed",
            "excluded"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverage"
          },
          "minItems": 6,
          "maxItems": 6
        },
        "transition": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "object_ref": {
              "type": "string",
              "minLength": 1
            },
            "from": {
              "type": "string",
              "minLength": 1
            },
            "to": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "object_ref",
            "from",
            "to"
          ]
        },
        "design_models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/design_model"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "object_refs",
        "segment_refs",
        "decision_refs",
        "condition",
        "action",
        "expected",
        "status",
        "coverage",
        "design_models"
      ]
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SEG-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "text",
            "table",
            "image",
            "diagram",
            "note",
            "link",
            "page",
            "slide",
            "sheet",
            "topic",
            "other"
          ]
        },
        "content": {
          "type": "string"
        },
        "read_status": {
          "enum": [
            "read",
            "needs-review",
            "unreadable",
            "excluded"
          ]
        },
        "disposition": {
          "enum": [
            "requirement",
            "context",
            "reference",
            "excluded"
          ]
        },
        "review_note": {
          "type": "string",
          "minLength": 1
        },
        "asset_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "source_id",
        "anchor",
        "kind",
        "content",
        "read_status",
        "disposition"
      ]
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^OBJ-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "segment_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "states",
        "segment_refs"
      ]
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^REL-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "from_object": {
          "type": "string",
          "minLength": 1
        },
        "to_object": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "rule_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "from_object",
        "to_object",
        "description",
        "rule_refs"
      ]
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FLOW-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "rule_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "title",
        "rule_refs",
        "outcome"
      ]
    },
    "coverage_item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^COV-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "enum": [
              "positive",
              "negative",
              "boundary",
              "state",
              "role",
              "cross-object"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "setup": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object",
          "minProperties": 1
        },
        "disposition": {
          "enum": [
            "required",
            "excluded"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "test_point_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "partition": {
          "type": "string",
          "minLength": 1
        },
        "boundary_ref": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "string"
          ]
        },
        "assignment": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "object_ref": {
                "type": "string",
                "minLength": 1
              },
              "before": {
                "type": "string",
                "minLength": 1
              },
              "after": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "object_ref",
              "before",
              "after"
            ]
          },
          "minItems": 2,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "dimensions",
        "condition",
        "action",
        "expected",
        "setup",
        "disposition",
        "test_point_refs"
      ]
    },
    "design_model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DM-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "method": {
          "enum": [
            "scenario",
            "equivalence-partition",
            "boundary",
            "decision-table",
            "state-transition",
            "permission",
            "cross-object"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverage_item"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "bounds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "resolution": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "basis": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "value",
              "resolution",
              "basis"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "factors": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "object_ref": {
          "type": "string",
          "minLength": 1
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "method",
        "rationale",
        "items"
      ]
    }
  }
}
