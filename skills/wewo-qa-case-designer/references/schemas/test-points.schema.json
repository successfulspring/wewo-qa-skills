{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wewo QA Test Point Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "project", "sources", "decisions", "requirement_units", "tree"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "artifact_id", "requirement", "baseline", "targets"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$"},
        "requirement": {"type": "string", "minLength": 1},
        "baseline": {"type": "string", "minLength": 1},
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/target"}
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/decision"}
    },
    "requirement_units": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/requirement_unit"}
    },
    "tree": {"$ref": "#/$defs/test_point"}
  },
  "$defs": {
    "nonempty_string_array": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "surface", "os", "in_scope"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$"},
        "name": {"type": "string", "minLength": 1},
        "surface": {"enum": ["web", "mobile-app", "desktop-app", "mini-program", "other"]},
        "os": {"enum": ["platform-independent", "windows", "macos", "linux", "android", "ios", "other"]},
        "browser": {"type": "string", "minLength": 1},
        "browser_version": {"type": "string", "minLength": 1},
        "os_version": {"type": "string", "minLength": 1},
        "device": {"type": "string", "minLength": 1},
        "device_mode": {"enum": ["real-device", "simulator", "emulator", "not-applicable"]},
        "host": {"type": "string", "minLength": 1},
        "in_scope": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "locator", "authority"],
      "properties": {
        "id": {"type": "string", "pattern": "^SRC-[0-9]{3,}$"},
        "title": {"type": "string", "minLength": 1},
        "type": {"enum": ["dingtalk-doc", "document", "spreadsheet", "presentation", "pdf", "image", "audio", "video", "xmind", "url", "text", "other"]},
        "locator": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "authority": {"enum": ["authoritative", "supporting", "historical", "unknown"]},
        "notes": {"type": "string"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "unit_id", "question_id", "topic", "resolution", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^DEC-[0-9]{3,}$"},
        "unit_id": {"type": "string", "pattern": "^RU-[0-9]{3,}$"},
        "question_id": {"type": "string", "pattern": "^Q-RU[0-9]{3,}-[0-9]{2,}$"},
        "selected_options": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-D]$"}
        },
        "topic": {"type": "string", "minLength": 1},
        "resolution": {"type": "string", "minLength": 1},
        "status": {"enum": ["confirmed", "assumed"]},
        "rationale": {"type": "string"}
      }
    },
    "requirement_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "source_refs", "status", "understanding", "confirmed_facts"],
      "properties": {
        "id": {"type": "string", "pattern": "^RU-[0-9]{3,}$"},
        "title": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "status": {"enum": ["confirmed", "assumed", "excluded"]},
        "understanding": {"type": "string", "minLength": 1},
        "confirmed_facts": {"$ref": "#/$defs/nonempty_string_array"},
        "assumptions": {"$ref": "#/$defs/nonempty_string_array"},
        "exclusion_reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "assumed"}}, "required": ["status"]},
          "then": {"required": ["assumptions"]}
        },
        {
          "if": {"properties": {"status": {"const": "excluded"}}, "required": ["status"]},
          "then": {"required": ["exclusion_reason"]}
        }
      ]
    },
    "test_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "status", "requirement_unit_refs", "trace_refs", "children"],
      "properties": {
        "id": {"type": "string", "pattern": "^TP-(?:ROOT|[A-Z0-9]+(?:-[A-Z0-9]+)*)$"},
        "title": {"type": "string", "minLength": 1},
        "kind": {"enum": ["root", "module", "feature", "flow", "rule", "state", "input", "boundary", "negative", "platform", "oracle", "other"]},
        "status": {"enum": ["confirmed", "assumed"]},
        "requirement_unit_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^RU-[0-9]{3,}$"}},
        "trace_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "rationale": {"type": "string", "minLength": 1},
        "automation_candidate": {"type": "boolean"},
        "notes": {"type": "string"},
        "children": {
          "type": "array",
          "items": {"$ref": "#/$defs/test_point"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "assumed"}}, "required": ["status"]},
          "then": {"required": ["rationale"]}
        }
      ]
    }
  }
}
