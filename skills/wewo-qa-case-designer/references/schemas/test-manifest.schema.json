{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wewo QA Test Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "project", "sources", "decisions", "test_points_baseline", "runtime_requirements", "cases"],
  "properties": {
    "schema_version": {"const": "1.2"},
    "generated_at": {"type": "string", "format": "date-time"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "artifact_id", "requirement", "baseline", "targets"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$"},
        "requirement": {"type": "string", "minLength": 1},
        "baseline": {"type": "string", "minLength": 1},
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/target"}
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/decision"}
    },
    "test_points_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "confirmed_at"],
      "properties": {
        "path": {"const": "test-points.json"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "confirmed_at": {"type": "string", "format": "date-time"}
      }
    },
    "runtime_requirements": {
      "type": "array",
      "items": {"$ref": "#/$defs/runtime_requirement"}
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/test_case"}
    }
  },
  "$defs": {
    "nonempty_string_array": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "surface", "os", "in_scope"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$"},
        "name": {"type": "string", "minLength": 1},
        "surface": {"enum": ["web", "mobile-app", "desktop-app", "mini-program", "other"]},
        "os": {"enum": ["platform-independent", "windows", "macos", "linux", "android", "ios", "other"]},
        "browser": {"type": "string", "minLength": 1},
        "browser_version": {"type": "string", "minLength": 1},
        "os_version": {"type": "string", "minLength": 1},
        "device": {"type": "string", "minLength": 1},
        "device_mode": {"enum": ["real-device", "simulator", "emulator", "not-applicable"]},
        "host": {"type": "string", "minLength": 1},
        "in_scope": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "locator", "authority"],
      "properties": {
        "id": {"type": "string", "pattern": "^SRC-[0-9]{3,}$"},
        "title": {"type": "string", "minLength": 1},
        "type": {"enum": ["dingtalk-doc", "document", "spreadsheet", "presentation", "pdf", "image", "audio", "video", "xmind", "url", "text", "other"]},
        "locator": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "authority": {"enum": ["authoritative", "supporting", "historical", "unknown"]},
        "notes": {"type": "string"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "topic", "resolution", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^DEC-[0-9]{3,}$"},
        "topic": {"type": "string", "minLength": 1},
        "resolution": {"type": "string", "minLength": 1},
        "status": {"enum": ["confirmed", "assumed"]},
        "rationale": {"type": "string"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "expected"],
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "expected": {"type": "string", "minLength": 1}
      }
    },
    "runtime_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "scope", "description", "sensitive", "collection"],
      "properties": {
        "id": {"type": "string", "pattern": "^RT-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["environment", "build", "account", "credential", "test-data", "device", "capability", "permission", "other"]},
        "scope": {"enum": ["run", "target", "case"]},
        "description": {"type": "string", "minLength": 1},
        "target_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "sensitive": {"type": "boolean"},
        "collection": {"enum": ["user-input", "environment-discovery", "secret-reference", "authenticated-session", "capability-check"]},
        "notes": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"scope": {"const": "target"}}, "required": ["scope"]},
          "then": {"required": ["target_ids"]}
        }
      ]
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "feasibility", "candidate_route", "runtime_requirement_refs", "required_evidence"],
      "properties": {
        "target_id": {"type": "string", "minLength": 1},
        "feasibility": {"enum": ["automatable", "conditional", "manual"]},
        "candidate_route": {"enum": ["browser-ui", "mobile-ui", "desktop-ui", "computer-use", "none"]},
        "runtime_requirement_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^RT-[A-Z0-9]+(?:-[A-Z0-9]+)*$"}},
        "condition": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "required_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["screenshot", "accessibility-snapshot", "video", "console", "network", "log", "system-state", "other"]}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"feasibility": {"const": "conditional"}}, "required": ["feasibility"]},
          "then": {"required": ["condition"]}
        },
        {
          "if": {"properties": {"feasibility": {"const": "manual"}}, "required": ["feasibility"]},
          "then": {"required": ["reason"]}
        }
      ]
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["impact", "requires_confirmation", "cleanup_steps"],
      "properties": {
        "impact": {"enum": ["none", "reversible", "irreversible", "external"]},
        "requires_confirmation": {"type": "boolean"},
        "cleanup_steps": {"$ref": "#/$defs/nonempty_string_array"},
        "notes": {"type": "string"}
      }
    },
    "test_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "source_refs", "test_point_refs", "priority", "risk", "suite_membership", "applicable_targets", "runtime_requirement_refs", "preconditions", "test_data", "steps", "automation", "safety"],
      "properties": {
        "id": {"type": "string", "pattern": "^QA-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3,}$"},
        "title": {"type": "string", "minLength": 1},
        "variant_of": {"type": "string", "pattern": "^QA-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3,}$"},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "test_point_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^TP-[A-Z0-9]+(?:-[A-Z0-9]+)*$"}},
        "priority": {"enum": ["P0", "P1", "P2", "P3"]},
        "risk": {"enum": ["high", "medium", "low"]},
        "suite_membership": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["smoke", "regression", "full"]}
        },
        "applicable_targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "runtime_requirement_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^RT-[A-Z0-9]+(?:-[A-Z0-9]+)*$"}},
        "preconditions": {"$ref": "#/$defs/nonempty_string_array"},
        "test_data": {"$ref": "#/$defs/nonempty_string_array"},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
        "automation": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/automation"}},
        "safety": {"$ref": "#/$defs/safety"},
        "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "notes": {"type": "string"}
      }
    }
  }
}
